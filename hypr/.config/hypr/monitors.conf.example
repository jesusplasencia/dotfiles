# Copy this file to monitors.conf and adjust for your display setup.
# monitors.conf is gitignored — it stays local to each machine.
#
# Format: monitor=<name>, <resolution>@<hz>, <position>, <scale>
# Use `hyprctl monitors` to list available displays.

monitor=DP-1, 1920x1080@60, 0x0, 1
monitor=HDMI-A-1, 1920x1080@60, 1920x0, 1
