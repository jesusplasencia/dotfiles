{
    "layer": "top",
    "position": "top",
    "height": 32,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left":   ["hyprland/workspaces"],
    "modules-center": [],
    "modules-right":  ["pulseaudio", "cpu", "memory", "clock#date", "clock#time", "tray"],

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "activate"
    },

    "clock#date": {
        "format": "󰃭 {:%d-%b-%Y}",
        "tooltip": false
    },

    "clock#time": {
        "format": " {:%H:%M}",
        "tooltip": false
    },

    "cpu": {
        "format": " {usage}%",
        "interval": 5,
        "tooltip": false
    },

    "memory": {
        "format": " {percentage}%",
        "interval": 10,
        "tooltip-format": "{used:0.1f}G / {total:0.1f}G"
    },

    "pulseaudio": {
        "format":        "{icon} {volume}%",
        "format-muted":  "󰝟 ",
        "format-icons":  { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click":      "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step":   5
    },

    "tray": {
        "spacing": 8
    }
}
