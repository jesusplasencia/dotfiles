# ~/.aws/config — versioned (no credentials here, ever)
# Credentials live in ~/.aws/credentials (outside the repo, gitignored globally)
#
# SSO login: aws sso login --profile <profile-name>
# Set active profile: export AWS_PROFILE=<profile-name>
#           or use: awsp <profile-name>   (defined in zsh aliases)

# ── DEFAULT OUTPUT ────────────────────────────────────────────────────────────
[default]
output = json
region = us-east-1

# ── SSO PROFILES ──────────────────────────────────────────────────────────────
# Template — copy and fill in per account. Run `aws configure sso` to generate.
#
# [profile dev]
# sso_session      = my-sso
# sso_account_id   = 123456789012
# sso_role_name    = AdministratorAccess
# region           = us-east-1
# output           = json
#
# [profile staging]
# sso_session      = my-sso
# sso_account_id   = 234567890123
# sso_role_name    = PowerUserAccess
# region           = us-east-1
# output           = json
#
# [profile prod]
# sso_session      = my-sso
# sso_account_id   = 345678901234
# sso_role_name    = ReadOnlyAccess
# region           = us-east-1
# output           = json

# ── SSO SESSION ───────────────────────────────────────────────────────────────
# Shared session referenced by all profiles above.
#
# [sso-session my-sso]
# sso_start_url        = https://YOUR_ORG.awsapps.com/start
# sso_region           = us-east-1
# sso_registration_scopes = sso:account:access
